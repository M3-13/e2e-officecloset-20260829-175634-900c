# Copy this file to `.env` (or export these variables in your shell) before
# starting the backend. The app reads them from the environment.

# JWT signing key. Required. Generate a fresh one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Everything below has a working default and is optional.
DATABASE_URL=sqlite:///./dev.db
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
ACCESS_TOKEN_EXPIRE_MINUTES=30
